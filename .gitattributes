# Normalize text files to LF.
* text=auto eol=lf

# Text formats used by the Quarto website and metadata pipeline.
*.qmd     text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.xml     text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.ipynb   text eol=lf

# Binary assets must never be newline-normalized.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.svgz    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.tar     binary
*.gz      binary
